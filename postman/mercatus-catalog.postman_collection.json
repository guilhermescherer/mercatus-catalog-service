{
  "info": {
    "name": "Mercatus - Catalog Service",
    "description": "Coleção dos endpoints do mercatus-catalog-service (Fase 2). Base: http://localhost:8080/api/v1.\n\nOs requests de criação salvam automaticamente os ids/versions em variáveis da coleção (categoryId, productId, skuId, categoryVersion, productVersion, skuVersion) via scripts de teste, permitindo encadear as chamadas na ordem das pastas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "categoryId", "value": "" },
    { "key": "categoryVersion", "value": "0" },
    { "key": "productId", "value": "" },
    { "key": "productVersion", "value": "0" },
    { "key": "skuId", "value": "" },
    { "key": "skuVersion", "value": "0" }
  ],
  "item": [
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Criar categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('categoryId', b.id);",
                  "pm.collectionVariables.set('categoryVersion', b.version);",
                  "pm.test('201 Created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Calçados Esportivos\",\n  \"parentId\": null\n}"
            }
          }
        },
        {
          "name": "Consultar categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Listar categorias (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories?page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name,asc" }
              ]
            }
          }
        },
        {
          "name": "Atualizar categoria (requer version)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('categoryVersion', b.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Calçados Esportivos\",\n  \"parentId\": null,\n  \"version\": {{categoryVersion}}\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Criar produto (DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('productId', b.id);",
                  "pm.collectionVariables.set('productVersion', b.version);",
                  "pm.test('201 Created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tênis Runner X\",\n  \"description\": \"Tênis de corrida\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"attributes\": { \"material\": \"mesh\" }\n}"
            }
          }
        },
        {
          "name": "Consultar produto (com SKUs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Listar produtos (filtros + paginação)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?categoryId={{categoryId}}&status=DRAFT&name=runner&page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "status", "value": "DRAFT" },
                { "key": "name", "value": "runner" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name,asc" }
              ]
            }
          }
        },
        {
          "name": "Atualizar produto (requer version)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('productVersion', b.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tênis Runner X\",\n  \"description\": \"Tênis de corrida atualizado\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"attributes\": { \"material\": \"mesh\" },\n  \"version\": {{productVersion}}\n}"
            }
          }
        },
        {
          "name": "Ativar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('productVersion', pm.response.json().version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}:activate",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}:activate"]
            }
          }
        },
        {
          "name": "Inativar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('productVersion', pm.response.json().version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}:deactivate",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}:deactivate"]
            }
          }
        }
      ]
    },
    {
      "name": "SKUs",
      "item": [
        {
          "name": "Adicionar SKU (com preço)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  const sku = b.skus[b.skus.length - 1];",
                  "  pm.collectionVariables.set('skuId', sku.id);",
                  "  pm.collectionVariables.set('skuVersion', sku.version);",
                  "  pm.collectionVariables.set('productVersion', b.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"RUNNER-X-42-BLACK\",\n  \"variationAttributes\": { \"size\": \"42\", \"color\": \"black\" },\n  \"price\": 299.90\n}"
            }
          }
        },
        {
          "name": "Atualizar SKU (requer version)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  const sku = b.skus.find(s => s.id === pm.collectionVariables.get('skuId'));",
                  "  if (sku) pm.collectionVariables.set('skuVersion', sku.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus/{{skuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus", "{{skuId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variationAttributes\": { \"size\": \"42\", \"color\": \"black\", \"edition\": \"2026\" },\n  \"version\": {{skuVersion}}\n}"
            }
          }
        },
        {
          "name": "Alterar preço do SKU (grava histórico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  const sku = b.skus.find(s => s.id === pm.collectionVariables.get('skuId'));",
                  "  if (sku) pm.collectionVariables.set('skuVersion', sku.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus/{{skuId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus", "{{skuId}}", "price"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"price\": 319.90\n}" }
          }
        },
        {
          "name": "Histórico de preço do SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus/{{skuId}}/price-history",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus", "{{skuId}}", "price-history"]
            }
          }
        },
        {
          "name": "Ativar SKU",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus/{{skuId}}:activate",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus", "{{skuId}}:activate"]
            }
          }
        },
        {
          "name": "Inativar SKU",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus/{{skuId}}:deactivate",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus", "{{skuId}}:deactivate"]
            }
          }
        }
      ]
    },
    {
      "name": "Erros (exemplos)",
      "item": [
        {
          "name": "Ativar sem SKU com preço (422)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}:activate",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}:activate"]
            },
            "description": "Esperado 422 quando o produto não tem categoria ou nenhum SKU com preço."
          }
        },
        {
          "name": "Preço negativo (422)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/skus/{{skuId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "skus", "{{skuId}}", "price"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"price\": -1.00\n}" }
          }
        },
        {
          "name": "Conflito de versão (409)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Qualquer\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"version\": 999\n}"
            },
            "description": "Esperado 409: version propositalmente desatualizada."
          }
        },
        {
          "name": "Produto inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["products", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Actuator health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ]
}
